<Window xmlns="https://github.com/avaloniaui"
        xmlns:t="using:Snip"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Snip.SnipWindow"
        Title="Snip"
        Width="1180" Height="640" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static t:Palette.Backdrop}">
  <DockPanel>
    <!-- Our own title row, as the Notes window; Windows draws the caption buttons over its right-hand end. -->
    <Border DockPanel.Dock="Top" Height="32" Background="{x:Static t:Palette.Chrome}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <StackPanel Orientation="Horizontal" Spacing="9" Margin="10,0,150,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Source="/Assets/snip.ico" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock x:Name="WindowTitle" Text="Snip" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Toolbar: history, the colour and width for marks, then the file -->
    <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.Toolbar}" Padding="8,5">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="Undo (Ctrl+Z)">
            <StackPanel><PathIcon Data="{StaticResource UndoIcon}" /><TextBlock Classes="label" Text="Undo" /></StackPanel>
          </Button>
          <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="Redo (Ctrl+Y)">
            <StackPanel><PathIcon Data="{StaticResource RedoIcon}" /><TextBlock Classes="label" Text="Redo" /></StackPanel>
          </Button>
          <Border Width="1" Height="30" Background="{x:Static t:Palette.BorderStrong}" Margin="8,0" />
        </StackPanel>
        <StackPanel x:Name="Swatches" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Size" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" VerticalAlignment="Center" />
          <Slider x:Name="WidthSlider" Width="130" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" Focusable="False" />
          <TextBlock x:Name="WidthLabel" Width="18" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button x:Name="OpenButton" Classes="tool" ToolTip.Tip="Open an image (Ctrl+O), or paste one (Ctrl+V)">
            <StackPanel><PathIcon Data="{StaticResource FileIcon}" /><TextBlock Classes="label" Text="Open" /></StackPanel>
          </Button>
          <Button x:Name="CopyButton" Classes="tool" ToolTip.Tip="Copy the picture, with your marks (Ctrl+C)">
            <StackPanel><PathIcon Data="{StaticResource CopyIcon}" /><TextBlock Classes="label" Text="Copy" /></StackPanel>
          </Button>
          <Button x:Name="SaveButton" Classes="tool" ToolTip.Tip="Save over the file (Ctrl+S)">
            <StackPanel><PathIcon Data="{StaticResource SaveIcon}" /><TextBlock Classes="label" Text="Save" /></StackPanel>
          </Button>
          <Button x:Name="SaveAsButton" Classes="tool" ToolTip.Tip="Save as a new file (Ctrl+Shift+S)">
            <StackPanel><PathIcon Data="{StaticResource SaveIcon}" /><TextBlock Classes="label" Text="Save as" /></StackPanel>
          </Button>
          <Button x:Name="FolderButton" Classes="tool" ToolTip.Tip="Show the file in its folder">
            <StackPanel><PathIcon Data="{StaticResource FolderIcon}" /><TextBlock Classes="label" Text="Folder" /></StackPanel>
          </Button>
          <Border Width="1" Height="30" Background="{x:Static t:Palette.BorderStrong}" Margin="8,0" />
          <Button x:Name="ThemeButton" Classes="tool">
            <StackPanel><PathIcon Data="{StaticResource ThemeIcon}" /><TextBlock x:Name="ThemeLabel" Classes="label" Text="Windows" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status: what the tool does, and the size and zoom -->
    <Border DockPanel.Dock="Bottom" Background="{x:Static t:Palette.Toolbar}" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="HintText" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SizeText" Grid.Column="1" FontSize="12" Foreground="{x:Static t:Palette.TextMuted}" Margin="16,0" VerticalAlignment="Center" />
        <Button x:Name="ZoomButton" Grid.Column="2" FontSize="12" Padding="8,2" MinHeight="0" Background="Transparent" Focusable="False"
                ToolTip.Tip="Fit to the window (Ctrl+0); Ctrl+1 for 100%, Ctrl+wheel to zoom" />
      </Grid>
    </Border>

    <!-- The tools -->
    <Border DockPanel.Dock="Left" Background="{x:Static t:Palette.Panel}" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ToolRail" Spacing="2" Margin="4,6" Width="64" />
      </ScrollViewer>
    </Border>

    <Panel>
      <t:SnipCanvas x:Name="Canvas" />
      <Canvas x:Name="Overlay" />
    </Panel>
  </DockPanel>
</Window>
